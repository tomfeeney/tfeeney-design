# Protect Kaiju Run high-score storage.
Options -Indexes

<FilesMatch "^(scores|score-submit-rate)\.json$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "^(highscore-arch\.php|htaccess|.*\.(bak|backup|old|orig|save|log|txt))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>